# App PROFILES (chromium/discord/obsidian) are no longer symlinked in here —
# they live at their real ~/.config/<app> paths as of 2026-07-21. Only config
# files belong in this repo; profile data does not. Keep these ignores as a
# guard in case an app ever recreates the path.
chromium/
discord/
obsidian/

# Ignore large data and cache directories
**/Cache/
**/Code Cache/
**/GPUCache/
**/*.log
**/*.old
**/*.bak
**/*.db
**/*.db-journal
**/*.wal
**/*.shada
**/*.swp
**/*.swo
**/.dds
**/sessions/
**/undo/
**/swap/
**/ShaderCache/
**/leveldb/
**/index/
**/LOG
**/MANIFEST*
**/CURRENT
**/LOCK
**/Session Storage/
**/Local Storage/
**/Sync Data/
**/VideoDecodeStats/
**/GrShaderCache/
**/DawnGraphiteCache/
**/DawnWebGPUCache/
**/segmentation_platform/

# gh account/token state — never publish (a gho_ token leaked here in 6f12ce1)
gh/.config/gh/hosts.yml

# NEVER track Claude settings.json — it accumulates permission allow-rules verbatim, and on
# 2026-08-03 one of them contained a plaintext sudo password (`printf <password>`), which was
# pushed to this PUBLIC repo. Allow-rules are machine-local and can capture anything typed.
claude/.claude/settings.json
claude/.claude/settings.local.json

# machine-local GitHub auth state. Held a gho_ token in commit 6f12ce1;
# never version it again. Rotate that token: history cannot be un-leaked.
gh/.config/gh/hosts.yml
