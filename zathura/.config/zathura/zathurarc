# zathura — plain reader, Tokyo Night chrome. Pages stay white; Ctrl-R toggles dark pages.
# (The old paper-texture config is parked as zathurarc.disabled-2026-07-28; not loaded.)

set selection-clipboard clipboard
set statusbar-basename  true
set window-title-basename true
set adjust-open         width
set scroll-page-aware   true
set page-v-padding      8
set page-h-padding      8

# UI chrome
set default-bg          "#1a1b26"
set default-fg          "#c0caf5"
set statusbar-bg        "#16161e"
set statusbar-fg        "#c0caf5"
set inputbar-bg         "#16161e"
set inputbar-fg         "#c0caf5"
set notification-bg     "#16161e"
set notification-fg     "#c0caf5"
set notification-error-bg "#16161e"
set notification-error-fg "#f7768e"
set notification-warning-bg "#16161e"
set notification-warning-fg "#e0af68"
set completion-bg       "#16161e"
set completion-fg       "#c0caf5"
set completion-highlight-bg "#7aa2f7"
set completion-highlight-fg "#1a1b26"
set completion-group-bg "#1a1b26"
set completion-group-fg "#7aa2f7"
set index-bg            "#1a1b26"
set index-fg            "#c0caf5"
set index-active-bg     "#7aa2f7"
set index-active-fg     "#1a1b26"
set highlight-color     "rgba(224,175,104,0.4)"
set highlight-active-color "rgba(255,158,100,0.5)"
set highlight-fg        "#1a1b26"

# Ctrl-R dark pages
set recolor-lightcolor  "#1a1b26"
set recolor-darkcolor   "#c0caf5"
set recolor-reverse-video true
