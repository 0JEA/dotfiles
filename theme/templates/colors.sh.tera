# shellcheck shell=bash
# ── Theme palette · shell ────────────────────────────────────────────────────
# GENERATED by matugen from theme/matugen/config.toml. DO NOT EDIT BY HAND —
# a re-theme overwrites this file. Edit theme/templates/colors.sh.tera.
#
# Consumed by the shell surfaces (tmux path_pills.sh, starship_path.sh) by
# sourcing it. Those stay ordinary scripts rather than becoming templates,
# because matugen deletes whatever a template omits and they are code.
#
# Provides each slot as hex (THEME_BG) and as decimal "R;G;B" for ANSI escapes
# (THEME_BG_RGB), which is the form starship_path.sh needs.

THEME_BG='{{ colors.bg_source.default.hex }}'
THEME_BG_DARK='{{ colors.bg_dark_source.default.hex }}'
THEME_BG_HL='{{ colors.bg_hl_source.default.hex }}'
THEME_FG='{{ colors.fg_source.default.hex }}'
THEME_FG_LIGHT='{{ colors.fg_light_source.default.hex }}'
THEME_COMMENT='{{ colors.comment_source.default.hex }}'
THEME_BLUE='{{ colors.blue_source.default.hex }}'
THEME_CYAN='{{ colors.cyan_source.default.hex }}'
THEME_MAGENTA='{{ colors.magenta_source.default.hex }}'
THEME_GREEN='{{ colors.green_source.default.hex }}'
THEME_YELLOW='{{ colors.yellow_source.default.hex }}'
THEME_ORANGE='{{ colors.orange_source.default.hex }}'
THEME_RED='{{ colors.red_source.default.hex }}'
THEME_SELECTION='{{ colors.selection_source.default.hex }}'
THEME_GRAY='{{ colors.gray_source.default.hex }}'
THEME_GRAY2='{{ colors.gray2_source.default.hex }}'
THEME_BRIGHT_BLACK='{{ colors.bright_black_source.default.hex }}'

# Decimal R;G;B for 24-bit ANSI escapes. Derived here rather than emitted by
# matugen so there is exactly one source of truth per slot.
_theme_hex2rgb() {
    local h="${1#\#}"
    printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

THEME_BG_RGB="$(_theme_hex2rgb "$THEME_BG")"
THEME_BG_DARK_RGB="$(_theme_hex2rgb "$THEME_BG_DARK")"
THEME_FG_RGB="$(_theme_hex2rgb "$THEME_FG")"
THEME_FG_LIGHT_RGB="$(_theme_hex2rgb "$THEME_FG_LIGHT")"
THEME_COMMENT_RGB="$(_theme_hex2rgb "$THEME_COMMENT")"
THEME_BLUE_RGB="$(_theme_hex2rgb "$THEME_BLUE")"
THEME_CYAN_RGB="$(_theme_hex2rgb "$THEME_CYAN")"
THEME_MAGENTA_RGB="$(_theme_hex2rgb "$THEME_MAGENTA")"
THEME_GREEN_RGB="$(_theme_hex2rgb "$THEME_GREEN")"
THEME_YELLOW_RGB="$(_theme_hex2rgb "$THEME_YELLOW")"
THEME_ORANGE_RGB="$(_theme_hex2rgb "$THEME_ORANGE")"
THEME_RED_RGB="$(_theme_hex2rgb "$THEME_RED")"
THEME_BRIGHT_BLACK_RGB="$(_theme_hex2rgb "$THEME_BRIGHT_BLACK")"
