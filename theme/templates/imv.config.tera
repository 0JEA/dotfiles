# ── Theme · imv ──────────────────────────────
# GENERATED by matugen. DO NOT EDIT BY HAND — edit
# theme/templates/imv.config.tera. Must contain the whole file; matugen
# deletes anything a template omits.
# Note imv wants a BARE hex with no leading #, hence hex_stripped.
#
# 🚨 KEEP EVERY LINE UNDER 200 BYTES, COMMENTS INCLUDED.
# imv parses this with inih, whose INI_MAX_LINE is 200 bytes. An over-long line
# makes imv exit with "Error in config file: .../config:1" and refuse to start
# AT ALL — even `imv --help` fails, and anything launching it (a file manager,
# xdg-open) just silently does nothing.
# The rule above used to be 199 bytes: box-drawing "─" is THREE bytes in UTF-8,
# so a 77-character line is a 199-byte line. Count bytes, not characters
# (`LC_ALL=C awk '{print length($0)}'`); a normal awk/wc -m counts characters
# and will tell you the line is fine.

# ==============================================================================
# IMV CONFIGURATION
# ==============================================================================
# Wayland-native image viewer. Tokyo Night themed to match the rest of the
# desktop (kitty, waybar, hyprlock, etc).
# ==============================================================================

[options]
# Fill the background with the Tokyo Night bg color instead of a checkerboard
background = {{ colors.bg_source.default.hex_stripped }}
overlay = false

# Start in a sane scaling mode: shrink to fit, but don't blow up small images
scaling_mode = shrink

# Loop back to the first image after the last (nice for slideshows/dirs)
loop_input = true

# 0 = no slideshow. Any other value STARTS imv as a slideshow that
# auto-advances (man 5 imv). Start one by hand with: imv -t 5 DIR
slideshow_duration = 0

# --- KEY BINDINGS (vim-style navigation) ---
[binds]
q = quit
<Left> = prev
<Right> = next
h = prev
l = next
j = pan 0 -50
k = pan 0 50
<space> = next
<backspace> = prev

+ = zoom 1
- = zoom -1
r = zoom 0
f = fullscreen

<Shift+R> = flip vertical
<Shift+H> = flip horizontal

gg = goto 1
<Shift+G> = goto -1

x = close
<Shift+X> = exec rm "$imv_current_file"

i = overlay
