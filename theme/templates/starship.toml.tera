# ==============================================================================
# STARSHIP CONFIGURATION (TOKYO NIGHT / CONNECTED PILLS)
# ==============================================================================
# MUST stay in sync with starship/.config/starship.toml. matugen renders this
# template over ~/.config/starship.toml, and that path is a SYMLINK into this
# repo, so apply-theme.sh writes straight through to the tracked file. Any
# non-color setting omitted here is silently deleted from the repo on the next
# re-theme.

# Directory-scan budget. Default is 30ms, which $HOME (400+ entries) exceeds on a
# cold btrfs metadata cache -> "Scanning current directory timed out" on first terminal.
scan_timeout = 500

# Use a clean, one-line format
format = """
${custom.path}\
$git_branch\
$git_status\
$character
"""

# --- PATH PILLS (per-subfolder cycling colors via external script) ---
[custom.path]
command = "bash $HOME/dotfiles/theme/scripts/starship_path.sh"
when = "true"
format = "$output"
shell = ["bash"]

# --- GIT PILL ---
[git_branch]
symbol = ""
style = "bg:{{ colors.magenta_source.default.hex }} fg:{{ colors.bg_source.default.hex }} bold"
# Git is optional, so we'll keep it as a standalone pill for safety.
format = "[]({{ colors.magenta_source.default.hex }})[$symbol $branch]($style)"

[git_status]
style = "bg:{{ colors.magenta_source.default.hex }} fg:{{ colors.bg_source.default.hex }} bold"
format = "[$all_status$ahead_behind]($style)[]({{ colors.magenta_source.default.hex }}) "

# --- PROMPT SYMBOL ---
[character]
success_symbol = "[❯ ](bold {{ colors.cyan_source.default.hex }})"
error_symbol = "[❯ ](bold {{ colors.red_source.default.hex }})"

[line_break]
disabled = true
