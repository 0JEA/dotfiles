# ── Theme · dunst ─────────────────────────────────────────────────────────
# GENERATED by matugen from theme/matugen/config.toml. DO NOT EDIT BY HAND —
# a re-theme overwrites this file. Edit theme/templates/dunstrc.tera.
#
# This template must contain the WHOLE dunstrc, not just the colours:
# matugen writes the rendered template verbatim, so anything omitted here is
# silently deleted from the real config. That failure has already eaten
# starship's scan_timeout and tmux's allow-passthrough on this machine.

[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-right
    offset = 10x10
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    transparency = 10
    separator_height = 2
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 0
    frame_width = 2
    frame_color = "{{ colors.blue_source.default.hex }}"
    gap_size = 4
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 5

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/wofi -p dunst --dmenu
    browser = /usr/bin/xdg-open

    always_run_script = true
    title = Dunst
    class = Dunst

    corner_radius = 8
    ignore_dbusclose = false

    force_xwayland = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "{{ colors.bg_source.default.hex }}"
    foreground = "{{ colors.fg_source.default.hex }}"
    frame_color = "{{ colors.gray2_source.default.hex }}"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "{{ colors.bg_source.default.hex }}"
    foreground = "{{ colors.fg_source.default.hex }}"
    frame_color = "{{ colors.blue_source.default.hex }}"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "{{ colors.bg_source.default.hex }}"
    foreground = "{{ colors.red_source.default.hex }}"
    frame_color = "{{ colors.red_source.default.hex }}"
    timeout = 0
    default_icon = dialog-error
