-- ── Theme palette · Neovim ───────────────────────────────────────────────────
-- GENERATED by matugen from theme/matugen/config.toml. DO NOT EDIT BY HAND —
-- a re-theme overwrites this file. Edit theme/templates/nvim-palette.lua.tera.
--
-- WHY THIS FILE EXISTS: nvim used to be the one surface where the palette was
-- duplicated by hand, in lua/plugins/example.lua. Switching palettes therefore
-- recoloured eight apps and left the editor behind, so the editor background
-- stopped matching the terminal and the syntax accents clashed with the rest of
-- the desktop. This file closes that gap: the 17 slots come from the same
-- [config.custom_colors] block everything else reads.
--
-- Only raw slots live here. The mapping onto tokyonight's colour keys stays in
-- lua/plugins/example.lua, so this file has nothing to lose if a key is renamed.

return {
  bg           = "{{ colors.bg_source.default.hex }}",
  bg_dark      = "{{ colors.bg_dark_source.default.hex }}",
  bg_hl        = "{{ colors.bg_hl_source.default.hex }}",
  fg           = "{{ colors.fg_source.default.hex }}",
  fg_light     = "{{ colors.fg_light_source.default.hex }}",
  comment      = "{{ colors.comment_source.default.hex }}",
  blue         = "{{ colors.blue_source.default.hex }}",
  cyan         = "{{ colors.cyan_source.default.hex }}",
  magenta      = "{{ colors.magenta_source.default.hex }}",
  green        = "{{ colors.green_source.default.hex }}",
  yellow       = "{{ colors.yellow_source.default.hex }}",
  orange       = "{{ colors.orange_source.default.hex }}",
  red          = "{{ colors.red_source.default.hex }}",
  selection    = "{{ colors.selection_source.default.hex }}",
  gray         = "{{ colors.gray_source.default.hex }}",
  gray2        = "{{ colors.gray2_source.default.hex }}",
  bright_black = "{{ colors.bright_black_source.default.hex }}",
}
