// GENERATED by matugen from theme/matugen/config.toml. DO NOT EDIT BY HAND.
// Edit theme/templates/eww-colors.scss.tera instead.
//
// This file holds COLOR TOKENS ONLY. All layout/structure lives in eww.scss,
// which @imports this. That split is deliberate and matches the colors.json /
// colors.sh pattern: matugen writes a rendered template VERBATIM and deletes
// anything the template omits, so anything matugen owns must be a file whose
// entire contents are regenerable. Layout CSS is not.

$bg:           {{ colors.bg_source.default.hex }};
$bg_dark:      {{ colors.bg_dark_source.default.hex }};
$bg_hl:        {{ colors.bg_hl_source.default.hex }};
$fg:           {{ colors.fg_source.default.hex }};
$fg_light:     {{ colors.fg_light_source.default.hex }};
$comment:      {{ colors.comment_source.default.hex }};
$blue:         {{ colors.blue_source.default.hex }};
$cyan:         {{ colors.cyan_source.default.hex }};
$magenta:      {{ colors.magenta_source.default.hex }};
$green:        {{ colors.green_source.default.hex }};
$yellow:       {{ colors.yellow_source.default.hex }};
$orange:       {{ colors.orange_source.default.hex }};
$red:          {{ colors.red_source.default.hex }};
$selection:    {{ colors.selection_source.default.hex }};
$gray:         {{ colors.gray_source.default.hex }};
$gray2:        {{ colors.gray2_source.default.hex }};
$bright_black: {{ colors.bright_black_source.default.hex }};

// NOTE: no rgba() channel triples here, unlike waybar.css.tera.
//
// waybar's stylesheet is plain CSS parsed by GTK at runtime, where
// `rgba(41, 33, 33, 0.9)` is the only spelling that works. eww instead compiles
// this through a real SCSS compiler (grass) FIRST, and Sass's own rgba() takes
// a colour plus an alpha: `rgba($bg_hl, 0.66)`. Passing it a bare "41, 33, 33"
// triple is a hard compile error ("$color: 41, 33, 33 is not a color") which
// makes eww fall back to unstyled widgets.
