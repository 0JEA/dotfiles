# ── MARIGOLD · Hyprland colors ────────────────────────────────────────────────
# GENERATED by matugen from theme/matugen/config.toml. DO NOT EDIT BY HAND —
# apply-theme.sh overwrites this file. Edit theme/templates/hypr-colors.conf.tera.
#
# WHY THIS FILE EXISTS: hyprland.conf is NOT templated on purpose. It holds
# monitors, keybinds, exec-once and input config, and matugen deletes anything a
# template omits (the same failure that ate starship's scan_timeout and tmux's
# allow-passthrough). Keeping a colors-ONLY file means there is nothing
# non-colour to lose. hyprland.conf sources this.

general {
    col.active_border = rgba({{ colors.blue_source.default.hex_stripped }}ee) rgba({{ colors.yellow_source.default.hex_stripped }}ee) 45deg
    col.inactive_border = rgba({{ colors.gray2_source.default.hex_stripped }}aa)
}
