#version 300 es
// Paper screen shader. ONE source, two looks, each a port of a sibling project:
//
//   LOOK 0  "pdf"  -- zathura-p's paper pass (~/zathura-paper patch/render.c):
//                     paperlab's baked tooth tile + the per-page field (lit
//                     cockle depth, marks, pits, scratches). Defaults are the
//                     tuned values in zathura/.config/zathura/zathurarc.
//   LOOK 1  "web"  -- paperweb's default `paper` preset (~/code/graphics/paperweb):
//                     lit cockle + gloss + cavity, GSM formation, fade, duotone.
//
// Both are pure functions of SCREEN position. A screen shader cannot follow the
// page as it scrolls (zathura and paperweb can), and Hyprland gives it no second
// sampler, so the tile zathura reads is regenerated procedurally here from the
// same formula paperlab bakes it with.
//
// main() must have NO early return: brightness.sh composes dim by inserting
// `fragColor.rgb *= k;` before the final `}`, and a return skips it.
precision highp float;
precision highp int;

in vec2 v_texcoord;
layout(location = 0) out vec4 fragColor;
uniform sampler2D tex;

#define LOOK            __LOOK__
#define STRENGTH        __STRENGTH__        // recolor-paper
#define TOOTH           __TOOTH__           // gain on the tile term (1 = as baked)
#define DEPTH           __DEPTH__           // recolor-paper-depth
#define DEPTH_SCALE     __DEPTH_SCALE__     // recolor-paper-depth-scale, mm
#define MARKS           __MARKS__           // recolor-paper-marks
#define MARK_DENSITY    __MARK_DENSITY__
#define MARK_SCALE      __MARK_SCALE__      // mm
#define PITS            __PITS__            // recolor-paper-pits
#define PIT_DENSITY     __PIT_DENSITY__
#define PIT_SCALE       __PIT_SCALE__       // mm
#define SCRATCHES       __SCRATCHES__       // recolor-paper-scratches
#define SCRATCH_DENSITY __SCRATCH_DENSITY__
#define SCRATCH_SCALE   __SCRATCH_SCALE__   // mm
#define SEED            __SEED__            // zathura seeds by page index + 1
#define MON_SCALE       __MON_SCALE__       // Hyprland monitor scale (web look only)

// Screen pixels per mm. 7.11 is the density paperlab bakes zathura's tile at
// (2048 px over 816 pt), so one tooth texel lands on one screen pixel: the grain
// reads at the size it was tuned at, on any monitor scale.
const float PX_PER_MM = 2048.0 / (816.0 * 25.4 / 72.0);

// #FFF3DE, the cream zathurarc and paperweb both settled on.
const vec3 CREAM = vec3(1.0, 0.953, 0.871);

// Only light pixels get papered; dark UI is left alone. Same gate paperweb uses
// for its ink. It keys on the pixel's own luma, so light-on-dark text is papered
// too, which is harmless while the screen is showing a light page.
const float GATE_LO = 0.55;
const float GATE_HI = 0.85;

// --- PCG hash over float bit patterns (paperweb common.js) ------------------
uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float hash21(vec2 p) {
    uvec2 q = floatBitsToUint(p);
    return float(pcgHash(q.x ^ pcgHash(q.y ^ 0x9e3779b9u))) * (1.0 / 4294967296.0);
}
vec2 hash22(vec2 p) {
    uvec2 q = floatBitsToUint(p);
    uint h = pcgHash(q.x ^ pcgHash(q.y ^ 0x9e3779b9u));
    return vec2(float(h), float(pcgHash(h ^ 0x85ebca6bu))) * (1.0 / 4294967296.0);
}

float vnoise(vec2 x) {
    vec2 i = floor(x), f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i), b = hash21(i + vec2(1, 0));
    float c = hash21(i + vec2(0, 1)), d = hash21(i + vec2(1, 1));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// paperlab's fbm: normalised to 0..1, rotated between octaves.
float fbm(vec2 x, int octaves, float gain, float lac) {
    float sum = 0.0, amp = 1.0, tot = 0.0;
    mat2 rot = mat2(0.7648, -0.6442, 0.6442, 0.7648);
    for (int i = 0; i < 8; ++i) {
        if (i >= octaves) break;
        sum += amp * vnoise(x);
        tot += amp;
        amp *= gain;
        x = rot * x * lac;
    }
    return sum / max(tot, 1e-5);
}

#if LOOK == 0
// ===========================================================================
// PDF: zathura-p
// ===========================================================================

// paperlab's ALBEDO pass with the `paperlab` preset, exactly what bake_tile()
// renders: GSM formation at 0.9 mm, amplitude 0.1, gsm 0.65, skew -0.25, with
// paperlab's own (odd) skew term. No fade, scratches or pits: the tile is pure
// tooth, the blemishes live in the per-page field below.
float formation(vec2 mm) {
    float f = fbm(mm / 0.9, 4, 0.55, 2.0) - 0.5;
    f *= 0.4 + 0.65 * fbm(mm / 4.5, 3, 0.5, 2.0);
    f += -0.25 * (f * abs(f) - 0.15);
    return 1.0 + 0.1 * f * 2.0;
}

// bake_tile()'s emboss: the formation field lit by an above-left light, times
// itself, as (factor - 1). The gradient step is one tile texel, as baked, and
// the clamp is the int8 quantiser's range (PAPER_TILE_SCALE = 0.101449).
float tooth_m1(vec2 mm) {
    const float E = 816.0 * 25.4 / 72.0 / 2048.0;   // one tile texel, mm
    float a  = formation(mm);
    float dx = (formation(mm + vec2(E, 0.0)) - formation(mm - vec2(E, 0.0))) * 0.5;
    float dy = (formation(mm + vec2(0.0, E)) - formation(mm - vec2(0.0, E))) * 0.5;
    vec2  n  = -vec2(dx, dy) * 16.0;
    float ndl = (n.x * -0.42 + n.y * 0.42 + 0.80) * inversesqrt(dot(n, n) + 1.0);
    float shade = clamp(1.0 + 0.5 * (ndl - 0.80), 0.84, 1.16);
    return clamp(a * shade - 1.0, -0.101449, 0.101449);
}

// --- render.c's per-page field, ported line for line ------------------------
uint pf_hash(int x, int y, uint seed) {
    uint h = uint(x) * 374761393u + uint(y) * 668265263u + seed * 2246822519u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    return h ^ (h >> 16u);
}
float pf_rand(int x, int y, uint seed) {
    return float(pf_hash(x, y, seed)) * (1.0 / 4294967295.0);
}
float pf_vnoise(vec2 p, uint seed) {
    int xi = int(floor(p.x)), yi = int(floor(p.y));
    float fx = p.x - float(xi), fy = p.y - float(yi);
    float u = fx * fx * (3.0 - 2.0 * fx), v = fy * fy * (3.0 - 2.0 * fy);
    float a = pf_rand(xi, yi, seed), b = pf_rand(xi + 1, yi, seed);
    float c = pf_rand(xi, yi + 1, seed), d = pf_rand(xi + 1, yi + 1, seed);
    return (a + (b - a) * u) + ((c - a) + (a - b - c + d) * u) * v;
}
float pf_fbm(vec2 p, uint seed) {
    float s = 0.0, a = 0.5, tot = 0.0;
    for (int i = 0; i < 3; i++) {
        vec2 r = vec2(p.x * 0.7648 - p.y * 0.6442, p.x * 0.6442 + p.y * 0.7648);
        s += a * pf_vnoise(r, seed + uint(i) * 131u);
        tot += a; p *= 2.03; a *= 0.5;
    }
    return s / tot;
}

// mm here is page-style: x right, y DOWN, as zathura's rows run.
float page_field_m1(vec2 mm) {
    const uint seed = uint(SEED);
    float field = 0.0;

    // broad isotropic cockle, lit above-left
    if (DEPTH > 0.0) {
        vec2 s = mm / DEPTH_SCALE;
        const float e = 0.08;
        float hx = pf_fbm(s + vec2(e, 0.0), seed) - pf_fbm(s - vec2(e, 0.0), seed);
        float hy = pf_fbm(s + vec2(0.0, e), seed) - pf_fbm(s - vec2(0.0, e), seed);
        float nx = -hx * 2.0, ny = -hy * 2.0;
        float ndl = (nx * -0.42 + ny * 0.42 + 0.80) * inversesqrt(nx * nx + ny * ny + 1.0);
        field = (ndl - 0.80) * DEPTH;
    }

    // Every blemish scans the 3x3 cell neighbourhood; testing only the own cell
    // clips features at the cell wall into hard squares.

    // rare large marks, light or dark
    if (MARKS > 0.0 && MARK_DENSITY > 0.0) {
        vec2 cm = mm / MARK_SCALE;
        int cx = int(floor(cm.x)), cy = int(floor(cm.y));
        for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            int gx = cx + i, gy = cy + j;
            if (pf_rand(gx, gy, seed ^ 0x9e3779b9u) >= MARK_DENSITY) continue;
            vec2 o = vec2(pf_rand(gx, gy, seed + 7u), pf_rand(gx, gy, seed + 13u));
            vec2 d = cm - (vec2(gx, gy) + o);
            float rad = 0.12 + 0.20 * pf_rand(gx, gy, seed + 21u);
            float dist = length(d);
            if (dist >= rad) continue;
            float m = 1.0 - dist / rad;
            m *= m;
            float sgn = (pf_rand(gx, gy, seed + 33u) < 0.5) ? -1.0 : 1.0;
            field += sgn * MARKS * m;
        }
    }

    // small dark pits
    if (PITS > 0.0 && PIT_DENSITY > 0.0) {
        vec2 cm = mm / PIT_SCALE;
        int cx = int(floor(cm.x)), cy = int(floor(cm.y));
        for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            int gx = cx + i, gy = cy + j;
            if (pf_rand(gx, gy, seed + 61u) >= PIT_DENSITY) continue;
            vec2 o = vec2(pf_rand(gx, gy, seed + 71u), pf_rand(gx, gy, seed + 83u));
            vec2 d = cm - (vec2(gx, gy) + o);
            float rad = 0.06 + 0.12 * pf_rand(gx, gy, seed + 97u);
            float dist = length(d);
            if (dist >= rad) continue;
            float m = 1.0 - dist / rad;
            field -= PITS * m * (0.5 + 0.5 * pf_rand(gx, gy, seed + 101u));
        }
    }

    // sparse scratches, mostly light
    if (SCRATCHES > 0.0 && SCRATCH_DENSITY > 0.0) {
        vec2 cm = mm / SCRATCH_SCALE;
        int cx = int(floor(cm.x)), cy = int(floor(cm.y));
        for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            int gx = cx + i, gy = cy + j;
            if (pf_rand(gx, gy, seed + 149u) >= SCRATCH_DENSITY) continue;
            vec2 o = vec2(pf_rand(gx, gy, seed + 151u), pf_rand(gx, gy, seed + 163u));
            float ang = pf_rand(gx, gy, seed + 173u) * 3.14159265358979;
            float ca = cos(ang), sa = sin(ang);
            vec2 d = cm - (vec2(gx, gy) + o);
            float perp  = d.x * -sa + d.y * ca;
            float along = d.x * ca + d.y * sa;
            float len = 0.30 + 0.45 * pf_rand(gx, gy, seed + 179u);
            float wid = 0.010 + 0.020 * pf_rand(gx, gy, seed + 191u);
            if (abs(perp) >= wid || abs(along) >= len) continue;
            float fall = (1.0 - abs(perp) / wid) * (1.0 - abs(along) / len);
            float sgn = (pf_rand(gx, gy, seed + 197u) < 0.3) ? -1.0 : 1.0;
            field += sgn * SCRATCHES * fall;
        }
    }
    return field;
}

vec3 apply_paper(vec3 src, vec2 frag, vec2 res) {
    vec2 mm = vec2(frag.x, res.y - frag.y) / PX_PER_MM;
    float shade_m1 = TOOTH * tooth_m1(mm) + page_field_m1(mm);
    // zathura: l *= 1 + paper * shade_m1, CLAMPED to 1, then out = lightcolor * l.
    // The clamp comes before the cream, so on a white page only the darkening
    // half of the texture shows. That is the PDF look, so it is kept.
    return CREAM * clamp(src * (1.0 + STRENGTH * shade_m1), 0.0, 1.0);
}

#else
// ===========================================================================
// WEB: paperweb, `paper` preset over params.defaults()
// ===========================================================================

// paperweb keeps paperlab's float hash for the RELIEF only (page.legacy = 2):
// on this GPU it is what gives the cockle its faceted character.
float lhash(vec2 p) {
    p = fract(p * vec2(123.34, 345.45));
    p += dot(p, p + 34.345);
    return fract(p.x * p.y);
}
float lvnoise(vec2 x) {
    vec2 i = floor(x), f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    float a = lhash(i), b = lhash(i + vec2(1, 0));
    float c = lhash(i + vec2(0, 1)), d = lhash(i + vec2(1, 1));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
float lfbm(vec2 x, int octaves) {
    float sum = 0.0, amp = 1.0, tot = 0.0;
    mat2 rot = mat2(0.7648, -0.6442, 0.6442, 0.7648);
    for (int i = 0; i < 8; ++i) {
        if (i >= octaves) break;
        sum += amp * lvnoise(x);
        tot += amp;
        amp *= 0.5;
        x = rot * x * 2.0;
    }
    return sum / max(tot, 1e-5);
}

// HEIGHT pass, cockle only: wavelength 30 mm, 22 um, anisotropy 2.2,
// irregularity 0.9. Returns um.
float height_um(vec2 mm) {
    vec2 t = mm;
    t.x /= 2.2;
    float organic = lfbm(t / (30.0 * 0.55), 3) - 0.5;
    float warp = (lfbm(t / 30.0, 2) - 0.5) * 2.0;
    float wave = 0.5 * sin(t.y * 6.2831853 / 30.0 + warp * 1.5);
    return mix(wave, organic * 1.6, 0.9) * 22.0;
}

// ALBEDO pass: fade 60 mm x 0.65, GSM formation 2.5 mm x 0.02, skew -0.3.
float albedo(vec2 mm) {
    float m = fbm(mm / 60.0, 3, 0.5, 2.0);
    float fade = clamp(8.0 * m * m * m, 0.0, 1.0) * 0.65;
    float f = fbm(mm / 2.5, 4, 0.55, 2.0) - 0.5;
    f *= 0.4 + 0.7 * fbm(mm / 12.5, 3, 0.5, 2.0);
    const float NOM_SD = 0.13;
    float fn = f / NOM_SD;
    f += -0.3 * NOM_SD * 0.5 * (fn * fn - 1.0);
    return 1.0 + 0.02 * f * 2.0 * mix(1.0, 0.35, fade);
}

// paperweb sizes everything in mm at a nominal 96 CSS px per inch, so on a
// scaled monitor a millimetre is MON_SCALE times more device pixels.
const float WEB_PX_PER_MM = MON_SCALE * 96.0 / 25.4;

// The relief at one point, in mm (y up, as paperweb's uv runs).
float shade_at(vec2 mm) {
    // NORMAL pass: central difference, exaggerate 7, one half-res texel.
    const float S = 2.0 / WEB_PX_PER_MM;
    float h0 = height_um(mm);
    float sx = (height_um(mm + vec2(S, 0.0)) - height_um(mm - vec2(S, 0.0))) * 0.001 / (2.0 * S);
    float sy = (height_um(mm + vec2(0.0, S)) - height_um(mm - vec2(0.0, S))) * 0.001 / (2.0 * S);
    vec3 N = normalize(vec3(-sx * 7.0, -sy * 7.0, 1.0));

    // SHADE pass: azimuth 116, altitude 50, gloss 0.5 at power 40.
    const float AZ = radians(116.0), AL = radians(50.0);
    vec3 L = vec3(cos(AL) * cos(AZ), cos(AL) * sin(AZ), sin(AL));
    float shade = 1.0 + (dot(N, L) - L.z);
    vec3 H = normalize(L + vec3(0.0, 0.0, 1.0));
    shade += 0.5 * (pow(max(dot(N, H), 0.0), 40.0) - pow(H.z, 40.0));

    // CAVITY: blur(h) - h at 0.8 mm, lambda 0.6. The separable Gaussian is
    // replaced by a ring of taps at its sigma, which is enough for a field this
    // smooth.
    float blur = 0.0;
    for (int k = 0; k < 6; k++) {
        float a = float(k) * 1.0471976;
        blur += height_um(mm + vec2(cos(a), sin(a)) * (0.8 / 3.0 * 2.0));
    }
    float dH = (blur / 6.0 - h0) * 0.001 * 40.0;
    shade -= 0.6 * max(dH, 0.0);

    // highlight shoulder toward a 1.22 ceiling
    if (shade > 1.0) shade = 1.0 + 0.22 * (1.0 - exp(-(shade - 1.0) / 0.22));
    return shade;
}

vec3 apply_paper(vec3 src, vec2 frag, vec2 res) {
    vec2 mm = frag / WEB_PX_PER_MM;

    // paperweb computes the relief at HALF resolution and the composite samples
    // it bilinearly. That upsample is what softens the creases; shading every
    // pixel directly drew them as hard dark lines. So shade the four nearest
    // half-res texel centres and blend, as the GPU's sampler would.
    vec2 hp = frag * 0.5 - 0.5;
    vec2 b = floor(hp), f = hp - b;
    vec2 c = (b + 0.5) * 2.0 / WEB_PX_PER_MM;   // centre of texel b, in mm
    const float T = 2.0 / WEB_PX_PER_MM;        // one half-res texel, mm
    float shade = mix(mix(shade_at(c),               shade_at(c + vec2(T, 0.0)), f.x),
                      mix(shade_at(c + vec2(0.0, T)), shade_at(c + vec2(T, T)),   f.x), f.y);

    // COMPOSITE: duotone 0.5, warm highlights, cool shadows.
    float s = shade - 1.0;
    vec3 warm = mix(vec3(1.0), vec3(1.02, 1.0, 0.96), clamp(s * 4.0, 0.0, 1.0) * 0.5);
    vec3 cool = mix(vec3(1.0), vec3(0.90, 0.92, 0.98), clamp(-s * 4.0, 0.0, 1.0) * 0.5);
    return clamp(src * CREAM * shade * albedo(mm) * warm * cool, 0.0, 1.0);
}
#endif

void main() {
    vec3 src = texture(tex, v_texcoord).rgb;
    float luma = dot(src, vec3(0.299, 0.587, 0.114));
    float blend = smoothstep(GATE_LO, GATE_HI, luma);
    vec3 result = src;
    // Branch, not return: see the header. Dark pixels skip the whole field.
    if (blend > 0.0) {
        vec2 res = vec2(textureSize(tex, 0));
        result = mix(src, apply_paper(src, gl_FragCoord.xy, res), blend);
    }
    fragColor = vec4(result, 1.0);
}
