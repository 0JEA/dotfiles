#version 300 es
// highp is REQUIRED, not a nicety: mediump carries ~10 mantissa bits, so at a
// noise coordinate of ~47 the ULP is ~0.046 and fract() — which the value-noise
// lattice is built on — loses nearly all its precision.
// (Measured: the AMD driver promotes mediump here anyway, so this is belt-and-
// braces for portability rather than a live fix.)
precision highp float;
precision highp int;

in vec2 v_texcoord;
layout(location = 0) out vec4 fragColor;
uniform sampler2D tex;

#define TWO_PI 6.28318530718
#define STRENGTH __STRENGTH__

// ---------------------------------------------------------------------------
// PCG2D integer hash — Jarzynski & Olano, JCGT 9(3) 2020.
// sin()/fract() hashes give visible grid artifacts here, and sin() is a
// transcendental: an early revision blew the per-frame budget and the driver
// silently truncated the frame to black.
//
// This is the shader's dominant cost: 8x V_MUL_LO_U32, which is QUARTER-RATE
// on GCN/Vega (~48 full-rate-equivalent cycles per call). Do NOT "optimise" it
// to V_MUL_U32_U24 — that truncates both operands to 24 bits, destroying the
// LCG's bijection mod 2^32; the `v ^= v >> 16` steps then mix the corrupted
// high bits back into the low bits we sample, reintroducing the exact grid
// artifacts PCG was chosen to avoid.
// ---------------------------------------------------------------------------
uvec2 pcg2d(uvec2 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * 1664525u;
    v.y += v.x * 1664525u;
    v ^= v >> 16u;
    v.x += v.y * 1664525u;
    v.y += v.x * 1664525u;
    v ^= v >> 16u;
    return v;
}
// int->uint is a defined 2's-complement reinterpret; float->uint is UNDEFINED
// for negatives, and the inter-octave rotation does produce negatives.
// *(1/4294967295.0) not /: 4294967295.0 isn't representable in f32 and rounds
// to 2^32, so the reciprocal is an exact power of two — bit-identical, and
// independent of whether the driver lowers fdiv to frcp+fmul.
float hash21(ivec2 p) { uvec2 h = pcg2d(uvec2(p)); return float(h.x) * (1.0 / 4294967295.0); }
vec2  hash22(ivec2 p) { uvec2 h = pcg2d(uvec2(p)); return vec2(h)   * (1.0 / 4294967295.0); }
float hash21(vec2 p) { return hash21(ivec2(floor(p))); }
vec2  hash22(vec2 p) { return hash22(ivec2(floor(p))); }

// ---------------------------------------------------------------------------
// IQ-style value noise + ANALYTIC gradient from ONE evaluation — the same 4
// hashes the plain value lookup already needed. .x reproduces the old
// valueNoise() algebraically; .yz is (d/dx, d/dy).
// ---------------------------------------------------------------------------
vec3 noised(vec2 st) {
    ivec2 i = ivec2(floor(st));
    vec2  f = fract(st);
    float a = hash21(i);
    float b = hash21(i + ivec2(1, 0));
    float c = hash21(i + ivec2(0, 1));
    float d = hash21(i + ivec2(1, 1));
    vec2 u  = f * f * (3.0 - 2.0 * f);
    vec2 du = 6.0 * f * (1.0 - f);
    float k1 = b - a;
    float k2 = c - a;
    float k3 = a - b - c + d;
    return vec3(a + k1 * u.x + k2 * u.y + k3 * u.x * u.y,
                du * vec2(k1 + k3 * u.y, k2 + k3 * u.x));
}
// DCE deletes du and the gradient math here, so this compiles to exactly the 4
// hashes + bilerp the old valueNoise() did. One source of truth keeps fade/
// rough and fiber on an identical noise field.
float valueNoise(vec2 st) { return noised(st).x; }

const mat2 ROT = mat2(0.7648, -0.6442, 0.6442, 0.7648); // rotate(0.7rad): anti-tiling

float fbm3(vec2 n) {
    float total = 0.0, amp = 1.0;
    for (int i = 0; i < 3; i++) {
        n = ROT * n;
        total += valueNoise(n) * amp;
        n *= 2.0;
        amp *= 0.6;
    }
    return total;
}
// normalised to ~0..1. The reference's fbm starts at amplitude .4 (max .83);
// this one starts at 1.0 (max 1.96). Feeding an un-normalised fbm into the
// 8*x^3 fade curve saturates it to 1.0 everywhere, which silently switches
// folds and scratches OFF entirely.
float fbm3n(vec2 n) { return fbm3(n) * (1.0 / 1.96); }

// fbm3 + analytic gradient. Octave k is sampled at p_k = 2^k * ROT^(k+1) * x,
// so dp_k/dx = 2^k * ROT^(k+1) and the contribution is amp * (dp_k/dx)^T * g.
// In GLSL `v * m` is the ROW-vector product == m^T * v — exactly the transpose
// needed. `m` derives only from the const ROT, so the chain constant-folds to
// literal mat2s: the bookkeeping is free.
// INVARIANT: n == m * input. Keep the two `m` lines glued to the two `n` lines.
vec3 fbm3d(vec2 n) {
    float total = 0.0, amp = 1.0;
    vec2  grad  = vec2(0.0);
    mat2  m     = mat2(1.0);
    for (int i = 0; i < 3; i++) {
        n = ROT * n;
        m = ROT * m;
        vec3 v = noised(n);
        total += v.x * amp;
        grad  += amp * (v.yz * m);
        n *= 2.0;
        m *= 2.0;
        amp *= 0.6;
    }
    return vec3(total, grad);
}

// ---------------------------------------------------------------------------
// FIBER — gradient MAGNITUDE of fbm. Ridges form along noise contours, giving
// curly filament structure (real pulp) instead of flat grain. This is the
// mid-frequency band the early versions lacked entirely.
//
// Was 4x fbm3 (48 pcg2d) central-differencing the gradient; now 1x fbm3d
// (12 pcg2d). The old epsilon (0.002 noise units = 0.196 screen px = 0.008
// lattice cells at the top octave) made the truncation error ~1e-4 — about
// 400x below the 1/255 output quantum. Same picture, a quarter of the cost.
// This trick does NOT transfer to `rough` — see the tripwire in main().
// ---------------------------------------------------------------------------
float fiberNoise(vec2 uv) { return length(fbm3d(uv).yz); }

// ---------------------------------------------------------------------------
// FOLDS — nearest-of-N random centres; returns the offset vector toward the
// nearest centre, faded by distance.
//
// Both call sites test the SAME 7 compile-time-constant centres, so they are
// fused into one pass. The nearest search runs on SQUARED distance (sqrt is
// monotonic, so the winner is identical), dropping 14 quarter-rate sqrts;
// clamp(d,0,1)^0.25 == clamp(d2,0,1)^0.125 for d >= 0.
//
// NOTE the ridge this feeds is `max(0, w + w2)` with w ~ w2, i.e. ~2w — a
// smooth broad gradient everywhere EXCEPT where the nearest-centre assignment
// flips, where a crease discontinuity appears. The broad term dominates; the
// creases are secondary. (Verified by rendering — the look is intentional.)
// ---------------------------------------------------------------------------
void folds2(vec2 uvA, vec2 uvB, float count, float seed, out vec2 wA, out vec2 wB) {
    vec2 pA = vec2(0.0), pB = vec2(0.0);
    float lA = 81.0, lB = 81.0;                     // 9.0^2
    for (int i = 0; i < 8; i++) {
        if (float(i) >= count) break;
        float fi = float(i);
        vec2 rnd = hash22(vec2(fi * 7.0 + 3.0, fi * 13.0 + seed * 17.0 + 5.0));
        float an = rnd.x * TWO_PI;
        vec2 p = vec2(cos(an), sin(an)) * rnd.y;    // compile-time constant
        vec2 dA = uvA - p; float d2A = dot(dA, dA);
        if (d2A < lA) { lA = d2A; pA = dA; }
        vec2 dB = uvB - p; float d2B = dot(dB, dB);
        if (d2B < lB) { lB = d2B; pB = dB; }
    }
    wA = mix(pA, vec2(0.0), sqrt(sqrt(sqrt(clamp(lA, 0.0, 1.0)))));
    wB = mix(pB, vec2(0.0), sqrt(sqrt(sqrt(clamp(lB, 0.0, 1.0)))));
}

// ---------------------------------------------------------------------------
// SCRATCHES — sparse, jittered, randomized length/width/curve/depth per cell.
// `wear` (0..1) is the curvature-driven mask: raised areas get rubbed more.
// ---------------------------------------------------------------------------
float scratches(vec2 p, float wear) {
    vec2 cell = floor(p);
    // wear raises local scratch probability — Substance's curvature-driven wear
    float thresh = mix(0.985, 0.90, clamp(wear, 0.0, 1.0));
    float exists = step(thresh, hash21(cell * 5.0 + 31.0));
    // 90-98.5% of cells have no scratch and `exists` multiplies the whole
    // result, so the 6 hashes + cos/sin below were pure waste. A scratch cell is
    // ~98px vs a wave64's ~8x8 tile => wave-uniform for ~84% of waves.
    // Bit-exact: every factor below is finite, so 0.0 * x == 0.0.
    if (exists == 0.0) return 0.0;

    vec2 f = fract(p);
    vec2 jitter = hash22(cell * 9.0 + 61.0) * 0.5 + 0.25;
    vec2 centered = f - jitter;
    float angle = hash21(cell * 3.0 + 97.0) * TWO_PI;
    vec2 dir = vec2(cos(angle), sin(angle));
    float along = dot(centered, dir);
    float perp = centered.x * -dir.y + centered.y * dir.x;
    perp += (hash21(cell * 11.0 + 131.0) - 0.5) * 0.6 * along * along;  // curve
    float halfLen = mix(0.10, 0.34, hash21(cell * 13.0 + 167.0));
    float width  = mix(0.010, 0.024, hash21(cell * 17.0 + 197.0));
    float depth  = mix(0.20, 1.0, hash21(cell * 19.0 + 233.0));
    float mask = step(abs(along), halfLen) * (1.0 - smoothstep(0.0, width, abs(perp)));
    float endFade = 1.0 - smoothstep(halfLen * 0.7, halfLen, abs(along));
    return mask * endFade * depth;   // exists == 1.0 here
}

// --- tuning (scaled by STRENGTH) -------------------------------------------
const float U_ROUGHNESS = 0.50 * STRENGTH;
const float U_FIBER     = 0.28 * STRENGTH;
const float U_FOLDS     = 0.35 * STRENGTH;
const float U_SCRATCH   = 0.30 * STRENGTH;
const float U_AO        = 0.35 * STRENGTH;
const float U_FOLDCOUNT = 7.0;
const float U_SEED      = 3.0;
const float U_FADE      = 0.70;  // input to the 8*x^3 curve; must stay unsaturated
const float U_RELIEF_Z  = 1.8;   // NOT strength-scaled; STRENGTH drives amplitude
const float U_GATE_LO   = 0.55;
const float U_GATE_HI   = 0.85;

void main() {
    vec4 pixColor = texture(tex, v_texcoord);
    float luma = dot(pixColor.rgb, vec3(0.299, 0.587, 0.114));

    // EARLY-OUT. smoothstep(U_GATE_LO, .., luma) is EXACTLY 0.0 for
    // luma <= U_GATE_LO, and mix(x, y, 0.0) is exactly x — so on dark pixels the
    // ~90-hash pipeline below was computed in full and thrown away. Output is
    // bit-identical. Legal under non-uniform control flow: nothing below uses an
    // implicit derivative (no dFdx/dFdy; the only texture() is above).
    // Measured on Vega 8 under continuous redraw: 96.4% -> 72.3% GPU busy,
    // i.e. this removes 53% of the shader's cost and 68% of its extra watts.
    if (luma < U_GATE_LO) {
        fragColor = vec4(pixColor.rgb, 1.0);
        return;
    }

    vec2 res = vec2(textureSize(tex, 0));
    // MUST be centred on 0: fold centres are placed in a unit circle about the
    // origin, so an uncentred 0..N range puts them all off-screen and leaves a
    // single giant radial gradient instead of interacting crease cells.
    vec2 patternUV = 5.0 * (v_texcoord - 0.5) * vec2(res.x / res.y, 1.0);

    // --- FADE: big-scale mask, cubed. Real paper is not uniformly distressed.
    // Without this every effect is statistically stationary — the single
    // biggest "this is procedural" tell.
    float fade = U_FADE * fbm3n(patternUV * 0.17 + U_SEED * 3.0);
    fade = clamp(8.0 * fade * fade * fade, 0.0, 1.0);

    // --- Each feature contributes its gradient AT ITS OWN SCALE. One global
    // epsilon cannot see both pixel-scale grain and page-scale folds.
    vec2 normal = vec2(0.0);

    // roughness — pixel scale. Do NOT "optimise" this into fbm3d(): the two
    // samples are 0.2 noise units apart (0.8 LATTICE CELLS at octave 2, ~1.3px),
    // so this is a wide band-pass difference of two nearly decorrelated samples,
    // NOT a derivative. The analytic gradient produces visibly different grain.
    // This is now the dominant cost (24 of ~49 hashes/px) and there is no way to
    // cut it without changing the look.
    vec2 rUv = 1.5 * (gl_FragCoord.xy - 0.5 * res);
    float rough = fbm3((rUv + vec2(1.0, 0.0)) * 0.1) - fbm3((rUv - vec2(1.0, 0.0)) * 0.1);

    // fiber — curly filaments, mid band
    float fiber = 0.5 * (fiberNoise(patternUV * 2.2) - 1.0);

    // folds — page scale, twice at offset UV
    vec2 fUv = patternUV * 0.22;
    vec2 w, w2;
    folds2(fUv, fUv + 0.007, U_FOLDCOUNT, U_SEED, w, w2);
    vec2 ridge = max(vec2(0.0), w + w2);

    // curvature-driven wear: scratches concentrate on raised crease ridges,
    // which also *correlates* the layers instead of stacking them independently
    float wear = clamp(length(ridge) * 2.5, 0.0, 1.0);
    float scr = scratches(patternUV * 2.2, wear);

    // fade modulates everything
    ridge = mix(ridge, vec2(0.0), fade);
    scr   = mix(scr, 0.0, fade);
    fiber *= mix(1.0, 0.5, fade);
    rough *= mix(1.0, 0.5, fade);

    normal += U_FOLDS * 4.0 * ridge;
    normal += U_ROUGHNESS * 1.5 * rough;
    normal += U_FIBER * fiber;
    normal -= U_SCRATCH * 3.0 * scr;

    // Light must have same-sign x and y. `rough`, `fiber` and `scr` are scalars
    // added to BOTH normal components, so their relief is pinned to the 45°
    // diagonal; a light like (-0.6, 0.8, ..) makes those terms cancel
    // (-0.4 + 0.53 = 0.13) and throws away ~80% of the response. Measured: fixing
    // this recovered grain 6.5x (0.13% -> 0.85% luminance variation).
    // (`folds` adds a genuine vec2 and is exempt.)
    vec3 N = normalize(vec3(normal, U_RELIEF_Z));
    vec3 lightDir = normalize(vec3(1.0, 2.0, 1.0));
    float shade = mix(0.90, 1.06, clamp(dot(N, lightDir), 0.0, 1.0));

    // ambient occlusion: creases sit in shadow
    float ao = 1.0 - U_AO * 0.12 * clamp(length(ridge) * 1.5, 0.0, 1.0);

    // Warm cream, specified as sRGB #ECE1CD. The whole shader is a pure MULTIPLY
    // (result = s * lerp(1, T, blend)), and multiply commutes exactly with a
    // power-law EOTF — so working in encoded space is correct here, not a bug.
    // Converting to linear would cost 6 pow() AND silently reinterpret shade's
    // 0.90 as linear reflectance, making the relief ~2.4x stronger. Don't.
    vec3 paperTone = vec3(0.925, 0.884, 0.804);

    // NB: this gate keys on the PIXEL's own luma, so it cannot tell "light
    // background" from "light foreground" — light-on-dark text (e.g. kitty's
    // #c0caf5 fg, luma 0.80) gets ~90% papered too. Harmless while reading a
    // dark-on-light page, which is the only time this shader is meant to be on.
    // Rec.601 coefficients are correct here: they are DEFINED for gamma-encoded
    // R'G'B'. Rec.709's are for linear light; using them would introduce the
    // mismatch, not fix it.
    float blend = smoothstep(U_GATE_LO, U_GATE_HI, luma);

    vec3 papered = pixColor.rgb * paperTone * shade * ao;
    vec3 result = mix(pixColor.rgb, papered, blend);

    fragColor = vec4(result, 1.0);
}
